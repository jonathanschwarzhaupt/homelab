AUTH_URL=https://cook.jonathanschwarzhaupt.net
UPLOADS_DIR=/app/uploads
VALKEY_URL=valkey://valkey:6379
# re-applied on every start, overriding the admin setting
PASSWORD_AUTH_ENABLED=true
# The AI and Obscura settings only seed Settings => Admin on the first start;
# after that, change them in the UI.
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
OBSCURA_ENDPOINT=ws://obscura:9222
