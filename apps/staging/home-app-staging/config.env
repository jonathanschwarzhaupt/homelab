# Non-secret configuration. Secrets come from the 1Password item
# home-app-staging-secrets (secrets.yaml); DB_CONNECTION from CNPG.

# production serves embedded assets and sets Secure cookies (served over HTTPS)
APP_ENV=production
APP_URL=https://home-app-staging.shrimp-algol.ts.net
PORT=8090
ROBOTS_NOINDEX=true

# requests arrive from the Tailscale proxy pod (k3s pod CIDR)
TRUSTED_PROXY_CIDRS=10.42.0.0/16

# Polar sandbox; production requires all product IDs
POLAR_SANDBOX_MODE=true
POLAR_PRODUCT_ID_PRO_MONTHLY=TODO
POLAR_PRODUCT_ID_PRO_YEARLY=TODO
POLAR_PRODUCT_ID_ENTERPRISE_MONTHLY=TODO
POLAR_PRODUCT_ID_ENTERPRISE_YEARLY=TODO

BANKING_SYNC_ENABLED=true
BANKING_STOP_EMAIL_ENABLED=true

LOG_FORMAT=json
LOG_HTTP=true
